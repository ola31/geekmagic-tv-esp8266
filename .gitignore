.pio
.vscode
*.bin
*.elf
*.map

# Host simulator build artefacts; the rendered sheets are regenerated by sim/build.sh
sim/*.o
sim/sim
sim/out/

# The verified stock image is kept in the tree: it is the only way back to the
# vendor firmware, and GeekMagic ships it as a zip that is easy to lose.
!stock-backup/*.bin
firmware-custom.bin.gz
stock-backup/*.zip
firmware-*.bin
rescue-*.bin
eboot/*.o
eboot/*.a
eboot/*.elf
eboot/*.map
eboot/*.elf.patched
eboot/*.elf.stock
